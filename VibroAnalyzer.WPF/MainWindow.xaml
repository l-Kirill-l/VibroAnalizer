<Window x:Class="VibroAnalyzer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Виброанализатор"
        Height="680"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown">

    <DockPanel LastChildFill="True">

        <ToolBar DockPanel.Dock="Top">
            <Button x:Name="btnStart" Content="▶ Старт" Click="BtnStart_Click" Margin="5"/>
            <Button x:Name="btnStop" Content="⏸ Стоп" Click="BtnStop_Click" IsEnabled="False" Margin="5"/>
            <Button x:Name="btnResume" Content="▶ Возобновить" Click="BtnResume_Click" IsEnabled="False" Margin="5"/>
            <Separator/>
            <Button x:Name="btnSave" Content="💾 Сохранить" Click="BtnSave_Click" IsEnabled="False" Margin="5"/>
            <Separator/>
            <Button x:Name="btnOpen" Content="📂 Открыть" Click="BtnOpen_Click" Margin="5"/>
            <Button x:Name="btnRecordNew" Content="⏺ Записать новый" Click="BtnRecordNew_Click" Margin="5"/>
            <Separator/>
            <Button x:Name="btnSettings" Content="⚙ Настройки" Click="BtnSettings_Click" Margin="5"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов к работе"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtFrequency" Text="Частота: 0 Гц"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtRMS" Text="RMS: 0"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="txtStats" Text="Пик-фактор: 0 | Эксцесс: 0"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Панель перемотки -->
        <Grid DockPanel.Dock="Bottom" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="0:00" Margin="10,0,10,0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnSeekBack" Content="⏪" Width="44" Margin="0,5,5,5"
                    PreviewMouseLeftButtonDown="BtnSeekBack_MouseDown"
                    PreviewMouseLeftButtonUp="BtnSeek_MouseUp"
                    LostMouseCapture="BtnSeek_LostMouseCapture"
                    ToolTip="Назад на шаг перемотки (клавиша ←)"/>
            <Slider x:Name="seekSlider" Grid.Column="2" Minimum="0" Maximum="100" Value="0"
                    ValueChanged="SeekSlider_ValueChanged" VerticalAlignment="Center"/>
            <Button Grid.Column="3" x:Name="btnSeekForward" Content="⏩" Width="44" Margin="5,5,0,5"
                    PreviewMouseLeftButtonDown="BtnSeekForward_MouseDown"
                    PreviewMouseLeftButtonUp="BtnSeek_MouseUp"
                    LostMouseCapture="BtnSeek_LostMouseCapture"
                    ToolTip="Вперёд на шаг перемотки (клавиша →)"/>
            <TextBlock Grid.Column="4" x:Name="txtTotalTime" Text="0:00" Margin="10,0,10,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="Время, сек:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtSeekTime" Width="80" VerticalAlignment="Center"
                         KeyDown="TxtSeekTime_KeyDown" LostFocus="TxtSeekTime_LostFocus"
                         ToolTip="Введите время в секундах (например 2,375) и нажмите Enter."/>
            </StackPanel>
        </Grid>

        <!-- Рабочая зона со ScrollViewer -->
        <ScrollViewer x:Name="plotsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="plotsStackPanel" Margin="5">

                <!-- График 1: Осциллограмма -->
                <GroupBox x:Name="groupOscillation" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerOscillation" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="📈 Осциллограмма сигнала" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotOscilloscope"/>
                </GroupBox>

                <!-- График 2: Спектр (БПФ) -->
                <GroupBox x:Name="groupSpectrum" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerSpectrum" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="📊 Спектр амплитуд (БПФ)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotSpectrum"/>
                </GroupBox>

                <!-- График 3: Спектрограмма (Водопад) -->
                <GroupBox x:Name="groupWaterfall" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerWaterfall" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="🌊 Спектрограмма (Водопад)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotSpectrogram"/>
                </GroupBox>

                <!-- График 4: Огибающая / RMS во времени -->
                <GroupBox x:Name="groupEnvelope" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerEnvelope" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="📉 Огибающая сигнала / RMS тренд" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotEnvelope"/>
                </GroupBox>

                <!-- График 5: Плотность спектра мощности (PSD) -->
                <GroupBox x:Name="groupPsd" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerPsd" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="⚡ Спектральная плотность мощности (PSD, дБ)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotPsd"/>
                </GroupBox>

                <!-- График 6: Автокорреляция (АКФ) -->
                <GroupBox x:Name="groupAcf" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerAcf" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="🔄 Автокорреляционная функция (АКФ)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotAcf"/>
                </GroupBox>

                <!-- График 7: Октавный анализ (1/3 октавы) -->
                <GroupBox x:Name="groupOctave" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerOctave" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="🎚 Октавные полосы (1/3 октавы)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotOctave"/>
                </GroupBox>

                <!-- График 8: Кепстральный анализ (Cepstrum) -->
                <GroupBox x:Name="groupCepstrum" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerCepstrum" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="🔬 Кепстральный анализ (Cepstrum)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotCepstrum"/>
                </GroupBox>

                <!-- График 9: Вейвлет-анализ (CWT) -->
                <GroupBox x:Name="groupCwt" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerCwt" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="🌀 Вейвлет-анализ (CWT)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotCwt"/>
                </GroupBox>

                <!-- График 10: Фазовый портрет / Карта Пуанкаре -->
                <GroupBox x:Name="groupPhase" Margin="0,0,0,8" MinHeight="220" Height="260">
                    <GroupBox.Header>
                        <Border x:Name="headerPhase" Background="Transparent" Padding="4"
                                MouseLeftButtonDown="ChartHeader_MouseLeftButtonDown"
                                ToolTip="Кликните для выбора. Масштаб высоты: Ctrl + колесико или Ctrl + (+/-). Сброс: двойной клик. Снять выбор: Esc или клик вне заголовка.">
                            <TextBlock Text="♾ Фазовый портрет x(t) vs x(t - τ)" FontWeight="SemiBold"/>
                        </Border>
                    </GroupBox.Header>
                    <ScottPlot:WpfPlot x:Name="wpfPlotPhase"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>