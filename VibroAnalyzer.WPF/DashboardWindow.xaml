<Window x:Class="VibroAnalyzer.WPF.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПАКИК — Главный экран (Диспетчер комплекса)"
        Height="870"
        Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Программно-аппаратный комплекс изучения колебаний (ПАКИК)" 
                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <!-- Блок 1: Общие настройки комплекса -->
            <GroupBox Grid.Row="1" Header="1. Общие настройки комплекса и потоков" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Тема оформления:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbTheme" Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="Светлая" IsSelected="True"/>
                        <ComboBoxItem Content="Тёмная"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Частота дискретизации (Гц):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbSampleRate" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="44100" Tag="44100" IsSelected="True"/>
                        <ComboBoxItem Content="48000" Tag="48000"/>
                        <ComboBoxItem Content="96000" Tag="96000"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Размер буфера (отсчетов):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbBufferSize" Grid.Row="2" Grid.Column="1" Height="25" Margin="0,0,0,8">
                        <ComboBoxItem Content="4096" Tag="4096"/>
                        <ComboBoxItem Content="8192" Tag="8192"/>
                        <ComboBoxItem Content="16384" Tag="16384" IsSelected="True"/>
                        <ComboBoxItem Content="32768" Tag="32768"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Шаг перемотки (сек):" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtSeekStep" Grid.Row="3" Grid.Column="1" Height="25" Text="1.0" VerticalContentAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Архитектура потоков:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cmbStreamStrategy" Grid.Row="4" Grid.Column="1" Height="25">
                        <ComboBoxItem Content="Единый многоканальный поток (Multiplexing)" IsSelected="True"/>
                        <ComboBoxItem Content="Изолированные потоки (Isolated Workers)" />
                    </ComboBox>
                </Grid>
            </GroupBox>

            <!-- Блок 2: Настройки Окна анализа №1 (Магнитный датчик) -->
            <GroupBox Grid.Row="2" Header="2. Настройки Окна анализа №1 (Магнитный датчик)" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Выбор физического канала:" VerticalAlignment="Center" Width="220"/>
                        <ComboBox x:Name="cmbChannel1" Height="25">
                            <ComboBoxItem Content="Канал 1 (Основной)" Tag="1" IsSelected="True"/>
                            <ComboBoxItem Content="Канал 2" Tag="2"/>
                            <ComboBoxItem Content="Канал 3" Tag="3"/>
                            <ComboBoxItem Content="Встроенный микрофон (Ноутбук)" Tag="4"/>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Инструменты анализа и графики:" VerticalAlignment="Center" Width="220"/>
                        <ComboBox Height="26" x:Name="cmbTools1" MaxDropDownHeight="450">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="-- Нажмите для выбора инструментов анализа --" IsSelected="True" Focusable="False"/>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkOsc1" Content="Осциллограмма сигнала" IsChecked="True"/>
                                    <TextBlock Text="Временная развертка амплитуды колебаний" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkSpec1" Content="Спектр амплитуд (БПФ)" IsChecked="True"/>
                                    <TextBlock Text="Преобразование Фурье: распределение частот и резонансов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkWaterfall1" Content="Спектрограмма (Водопад)" IsChecked="True"/>
                                    <TextBlock Text="Тепловая карта эволюции спектра во времени" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <Separator/>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkEnv1" Content="Огибающая / RMS во времени" IsChecked="True"/>
                                    <TextBlock Text="Оценка общей мощности, затухания и тренда вибрации" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkPsd1" Content="Спектр мощности (PSD)" IsChecked="True"/>
                                    <TextBlock Text="Плотность спектра мощности (дБ/Гц) для стохастических сигналов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkAcf1" Content="Автокорреляция (АКФ)" IsChecked="False"/>
                                    <TextBlock Text="Поиск скрытых периодичностей и эхо-откликов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkOctave1" Content="Октавные полосы (1/3 октавы)" IsChecked="False"/>
                                    <TextBlock Text="Акустический фильтр: анализ шума и музыкального тембра" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkCepstrum1" Content="Кепстральный анализ (Cepstrum)" IsChecked="False"/>
                                    <TextBlock Text="Выявление гармонических сеток и боковых полос зубчатых передач" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkCwt1" Content="Вейвлет-анализ (CWT)" IsChecked="False"/>
                                    <TextBlock Text="Вейвлет-скалограмма для импульсов и сейсмических событий" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkPhase1" Content="Фазовый портрет / Карта Пуанкаре" IsChecked="False"/>
                                    <TextBlock Text="Фазовая траектория x(t) vs x(t-tau) для нелинейной динамики" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- Блок 3: Настройки Окна анализа №2 (Емкостной датчик) -->
            <GroupBox Grid.Row="3" Header="3. Настройки Окна анализа №2 (Емкостной датчик)" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Выбор физического канала:" VerticalAlignment="Center" Width="220"/>
                        <ComboBox x:Name="cmbChannel2" Height="25">
                            <ComboBoxItem Content="Канал 1" Tag="1"/>
                            <ComboBoxItem Content="Канал 2 (Основной)" Tag="2" IsSelected="True"/>
                            <ComboBoxItem Content="Канал 3" Tag="3"/>
                            <ComboBoxItem Content="Встроенный микрофон (Ноутбук)" Tag="4"/>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="Инструменты анализа и графики:" VerticalAlignment="Center" Width="220"/>
                        <ComboBox Height="26" x:Name="cmbTools2" MaxDropDownHeight="450">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="-- Нажмите для выбора инструментов анализа --" IsSelected="True" Focusable="False"/>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkOsc2" Content="Осциллограмма сигнала" IsChecked="True"/>
                                    <TextBlock Text="Временная развертка амплитуды колебаний" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkSpec2" Content="Спектр амплитуд (БПФ)" IsChecked="True"/>
                                    <TextBlock Text="Преобразование Фурье: распределение частот и резонансов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkWaterfall2" Content="Спектрограмма (Водопад)" IsChecked="True"/>
                                    <TextBlock Text="Тепловая карта эволюции спектра во времени" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <Separator/>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkEnv2" Content="Огибающая / RMS во времени" IsChecked="True"/>
                                    <TextBlock Text="Оценка общей мощности, затухания и тренда вибрации" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkPsd2" Content="Спектр мощности (PSD)" IsChecked="True"/>
                                    <TextBlock Text="Плотность спектра мощности (дБ/Гц) для стохастических сигналов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkAcf2" Content="Автокорреляция (АКФ)" IsChecked="False"/>
                                    <TextBlock Text="Поиск скрытых периодичностей и эхо-откликов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkOctave2" Content="Октавные полосы (1/3 октавы)" IsChecked="False"/>
                                    <TextBlock Text="Акустический фильтр: анализ шума и музыкального тембра" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkCepstrum2" Content="Кепстральный анализ (Cepstrum)" IsChecked="False"/>
                                    <TextBlock Text="Выявление гармонических сеток и боковых полос зубчатых передач" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkCwt2" Content="Вейвлет-анализ (CWT)" IsChecked="False"/>
                                    <TextBlock Text="Вейвлет-скалограмма для импульсов и сейсмических событий" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem>
                                <StackPanel Margin="0,2,0,2">
                                    <CheckBox x:Name="chkPhase2" Content="Фазовый портрет / Карта Пуанкаре" IsChecked="False"/>
                                    <TextBlock Text="Фазовая траектория x(t) vs x(t-tau) для нелинейной динамики" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <!-- Блок 4: Настройки служебных окон (№3 Сырые данные и №4 Демодуляция) -->
            <GroupBox Grid.Row="4" Header="4. Настройки служебных окон (№3 Сырые данные и №4 Демодуляция)" Padding="10" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Окно №3: Сырые данные / Composite -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Окно №3 (Сырые данные / Composite):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Прямой нефильтрованный поток аудиовхода/микрофона без разделения каналов." 
                                   TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Входной поток:" VerticalAlignment="Center" Width="90"/>
                            <ComboBox x:Name="cmbChannel3" Height="25">
                                <ComboBoxItem Content="Встроенный микрофон (Ноутбук)" Tag="4" IsSelected="True"/>
                                <ComboBoxItem Content="Аудиовход (Composite)" Tag="1"/>
                            </ComboBox>
                        </DockPanel>

                        <!-- Список инструментов для Окна №3 с подсказками -->
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Инструменты:" VerticalAlignment="Center" Width="90"/>
                            <ComboBox Height="25" x:Name="cmbTools3" MaxDropDownHeight="450">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="-- Инструменты №3 --" IsSelected="True" Focusable="False"/>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkOsc3" Content="Осциллограмма" IsChecked="True"/>
                                        <TextBlock Text="Временная развертка амплитуды" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkSpec3" Content="Спектр амплитуд (БПФ)" IsChecked="True"/>
                                        <TextBlock Text="Анализ частотного состава сигнала" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkWaterfall3" Content="Спектрограмма (Водопад)" IsChecked="True"/>
                                        <TextBlock Text="Динамика спектра во времени" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <Separator/>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkEnv3" Content="Огибающая / RMS во времени" IsChecked="False"/>
                                        <TextBlock Text="Тренд эффективной мощности" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkPsd3" Content="Спектр мощности (PSD)" IsChecked="False"/>
                                        <TextBlock Text="Плотность мощности случайного шума" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkAcf3" Content="Автокорреляция (АКФ)" IsChecked="False"/>
                                        <TextBlock Text="Обнаружение периодичностей" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkOctave3" Content="Октавные полосы" IsChecked="False"/>
                                        <TextBlock Text="Стандартный акустический спектр" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkCepstrum3" Content="Кепстр (Cepstrum)" IsChecked="False"/>
                                        <TextBlock Text="Периодичность спектральных гармоник" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkCwt3" Content="Вейвлет (CWT)" IsChecked="False"/>
                                        <TextBlock Text="Частотно-временная локализация ударов" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkPhase3" Content="Фазовый портрет" IsChecked="False"/>
                                        <TextBlock Text="Фазовая диаграмма x(t) vs x(t-tau)" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>

                    <!-- Окно №4: Демодуляция несущей -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Окно №4 (Демодуляция несущей):" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Выделение полезного сигнала из высокочастотной несущей (20 кГц)." 
                                   TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Входной канал:" VerticalAlignment="Center" Width="90"/>
                            <ComboBox x:Name="cmbChannel4" Height="25">
                                <ComboBoxItem Content="Канал 1" Tag="1"/>
                                <ComboBoxItem Content="Канал 2" Tag="2"/>
                                <ComboBoxItem Content="Канал 3 (Основной)" Tag="3" IsSelected="True"/>
                                <ComboBoxItem Content="Встроенный микрофон (Ноутбук)" Tag="4"/>
                            </ComboBox>
                        </DockPanel>

                        <!-- Список инструментов для Окна №4 с подсказками -->
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="Инструменты:" VerticalAlignment="Center" Width="90"/>
                            <ComboBox Height="25" x:Name="cmbTools4" MaxDropDownHeight="450">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBoxItem Content="-- Инструменты №4 --" IsSelected="True" Focusable="False"/>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkOsc4" Content="Осциллограмма" IsChecked="True"/>
                                        <TextBlock Text="Временная развертка амплитуды" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkSpec4" Content="Спектр амплитуд (БПФ)" IsChecked="True"/>
                                        <TextBlock Text="Анализ частотного состава сигнала" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkWaterfall4" Content="Спектрограмма (Водопад)" IsChecked="False"/>
                                        <TextBlock Text="Динамика спектра во времени" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <Separator/>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkEnv4" Content="Огибающая / RMS во времени" IsChecked="True"/>
                                        <TextBlock Text="Выделенная огибающая модуляции" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkPsd4" Content="Спектр мощности (PSD)" IsChecked="True"/>
                                        <TextBlock Text="Плотность спектра мощности" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkAcf4" Content="Автокорреляция (АКФ)" IsChecked="False"/>
                                        <TextBlock Text="Обнаружение периодичностей" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkOctave4" Content="Октавные полосы" IsChecked="False"/>
                                        <TextBlock Text="Стандартный акустический спектр" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkCepstrum4" Content="Кепстр (Cepstrum)" IsChecked="False"/>
                                        <TextBlock Text="Периодичность спектральных гармоник" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkCwt4" Content="Вейвлет (CWT)" IsChecked="False"/>
                                        <TextBlock Text="Частотно-временная локализация" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem>
                                    <StackPanel Margin="0,2,0,2">
                                        <CheckBox x:Name="chkPhase4" Content="Фазовый портрет" IsChecked="False"/>
                                        <TextBlock Text="Фазовая диаграмма x(t) vs x(t-tau)" FontSize="10" Foreground="Gray" Margin="20,1,0,0"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Панель запуска окон комплекса с кнопками мультизапуска и закрытия группы -->
            <GroupBox Grid.Row="5" Header="Управление окнами комплекса" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопки открытия окон -->
                    <Button Grid.Row="0" Grid.Column="0" x:Name="btnOpenWindow1" Content="📊 Окно №1 (Магн.)" Click="BtnOpenWindow1_Click" Height="32" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="1" x:Name="btnOpenWindow2" Content="📈 Окно №2 (Емк.)" Click="BtnOpenWindow2_Click" Height="32" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="btnOpenWindow3" Content="🎛 Окно №3 (Сырые)" Click="BtnOpenWindow3_Click" Height="32" Margin="3"/>
                    <Button Grid.Row="0" Grid.Column="3" x:Name="btnOpenWindow4" Content="⚙ Окно №4 (Демодул.)" Click="BtnOpenWindow4_Click" Height="32" Margin="3"/>

                    <!-- Кнопки группового закрытия окон соответствующего раздела -->
                    <Button Grid.Row="1" Grid.Column="0" x:Name="btnCloseAllWindows1" Content="✖ Закрыть все №1" Click="BtnCloseAllWindows1_Click" Height="26" Margin="3,4,3,0"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="btnCloseAllWindows2" Content="✖ Закрыть все №2" Click="BtnCloseAllWindows2_Click" Height="26" Margin="3,4,3,0"/>
                    <Button Grid.Row="1" Grid.Column="2" x:Name="btnCloseAllWindows3" Content="✖ Закрыть все №3" Click="BtnCloseAllWindows3_Click" Height="26" Margin="3,4,3,0"/>
                    <Button Grid.Row="1" Grid.Column="3" x:Name="btnCloseAllWindows4" Content="✖ Закрыть все №4" Click="BtnCloseAllWindows4_Click" Height="26" Margin="3,4,3,0"/>
                </Grid>
            </GroupBox>

            <!-- Статус бар -->
            <StatusBar Grid.Row="6">
                <StatusBarItem>
                    <TextBlock x:Name="txtDashboardStatus" Text="Панель управления готова. Выберите конфигурацию и запустите нужные окна."/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </ScrollViewer>
</Window>