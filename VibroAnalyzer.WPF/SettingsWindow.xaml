<Window x:Class="VibroAnalyzer.WPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="460"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Тема оформления -->
        <TextBlock Grid.Row="0" Text="Тема оформления:" Margin="0,0,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cmbTheme" Grid.Row="1" Margin="0,0,0,15">
            <ComboBoxItem Content="Светлая"/>
            <ComboBoxItem Content="Тёмная"/>
        </ComboBox>

        <!-- Частота дискретизации -->
        <TextBlock Grid.Row="2" Text="Частота дискретизации (Гц):" Margin="0,0,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cmbSampleRate" Grid.Row="3" Margin="0,0,0,15">
            <ComboBoxItem Content="44100" Tag="44100"/>
            <ComboBoxItem Content="48000" Tag="48000"/>
            <ComboBoxItem Content="96000" Tag="96000"/>
        </ComboBox>

        <!-- Размер буфера -->
        <TextBlock Grid.Row="4" Text="Размер буфера (отсчетов):" Margin="0,0,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="cmbBufferSize" Grid.Row="5" Margin="0,0,0,15">
            <ComboBoxItem Content="4096" Tag="4096"/>
            <ComboBoxItem Content="8192" Tag="8192"/>
            <ComboBoxItem Content="16384" Tag="16384"/>
            <ComboBoxItem Content="32768" Tag="32768"/>
        </ComboBox>

        <!-- Шаг перемотки -->
        <TextBlock Grid.Row="6" Text="Шаг перемотки (сек):" Margin="0,0,0,5" FontWeight="Bold"/>
        <TextBox x:Name="txtSeekStep" Grid.Row="7" Margin="0,0,0,15"
                 ToolTip="Шаг кнопок и стрелок перемотки в секундах, например 0,5 или 2,5"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button x:Name="btnApply" Content="Применить" Click="BtnApply_Click" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Click="BtnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>