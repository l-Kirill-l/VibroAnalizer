<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="640"
        x:Class="VibroAnalyzer.App.FindSignalWindow"
        Title="Поиск сигнала"
        Width="860" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <Border Classes="chassis" Margin="12">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <StackPanel Spacing="2">
                    <TextBlock Classes="tag" Text="ПОИСК СИГНАЛА" />
                    <TextBlock Classes="hero" Text="Где отреагировал вход" FontSize="22" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="CloseButton" Content="Закрыть"
                        Classes="small" VerticalAlignment="Top" />
            </Grid>

            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                <TextBlock Classes="hint"
                           Text="Сканируются все выбранные карты и входные порты. Сигнал может появиться сразу на нескольких каналах — выберите нужный вручную." />

                <WrapPanel>
                    <TextBlock Classes="label" Text="КАРТА" Margin="0,0,7,0" />
                    <ComboBox x:Name="CardCombo" Width="220" Margin="0,0,12,0" />
                    <TextBlock Classes="label" Text="ВХОД" Margin="0,0,7,0" />
                    <ComboBox x:Name="PortCombo" Width="250" Margin="0,0,12,0" />
                    <TextBlock Classes="label" Text="ПОРОГ, dBFS" Margin="0,0,7,0" />
                    <NumericUpDown x:Name="ThresholdBox" Width="110" Margin="0,0,12,0"
                                   Minimum="-120" Maximum="0" Increment="5"
                                   FormatString="0" ClipValueToMinMax="True" Value="-60" />
                    <Button x:Name="ScanButton" Content="Сканировать" Classes="primary" />
                </WrapPanel>

                <TextBlock x:Name="StatusText" Classes="hint" Text="Готово к сканированию." />
            </StackPanel>

            <Border Classes="card">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" x:Name="SelectButton" Content="Выбрать канал"
                            Classes="primary" HorizontalAlignment="Left"
                            Margin="0,10,0,0" IsEnabled="False" />
                    <ListBox x:Name="ResultsList" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single" />
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
