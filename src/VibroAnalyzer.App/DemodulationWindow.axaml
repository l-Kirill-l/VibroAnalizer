<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="720"
        x:Class="VibroAnalyzer.App.DemodulationWindow"
        Title="Демодуляция"
        Width="640" Height="720"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Border Classes="chassis" Margin="12">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">

                <StackPanel Spacing="3">
                    <TextBlock Classes="tag" Text="ПРИЁМ · ДЕМОДУЛЯЦИЯ" />
                    <TextBlock Classes="hero" Text="Демодуляция" FontSize="22" />
                    <TextBlock Classes="subtitle"
                               Text="Детектор огибающей или синхронный детектор. Изменения применяются сразу." />
                    <TextBlock x:Name="BoundText" Classes="hint" Text="Шина не задана" />
                </StackPanel>

                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <CheckBox x:Name="EnabledCheckBox" Content="Демодуляция включена" />
                        <TextBlock Classes="module-label" Text="ПАРАМЕТРЫ ДЕТЕКТОРА" />

                        <Grid ColumnDefinitions="*,170"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="9" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label"
                                       Text="ТИП ДЕТЕКТОРА" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      x:Name="KindComboBox"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Нет" />
                                <ComboBoxItem Content="Огибающая" />
                                <ComboBoxItem Content="Синхронная" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label"
                                       Text="ЧАСТОТА НЕСУЩЕЙ, ГЦ" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1"
                                           x:Name="CarrierFrequencyBox"
                                           Minimum="10" Maximum="20000" Increment="1"
                                           FormatString="0" ClipValueToMinMax="True" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label"
                                       Text="СРЕЗ ФНЧ, ГЦ" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1"
                                           x:Name="LowPassCutoffBox"
                                           Minimum="1" Maximum="20000" Increment="1"
                                           FormatString="0" ClipValueToMinMax="True" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Classes="label"
                                       Text="ИСХОДНЫЙ КАНАЛ" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1"
                                           x:Name="SourceChannelBox"
                                           Minimum="0" Maximum="7" Increment="1"
                                           FormatString="0" ClipValueToMinMax="True" />
                        </Grid>

                        <TextBlock Classes="hint"
                                   Text="Частота несущей используется синхронным детектором. Фильтр нижних частот сглаживает результат демодуляции." />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="9">
                        <TextBlock Classes="module-label" Text="ПОСЛЕДНИЕ ИЗМЕРЕНИЯ" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" Classes="readout">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="readout-label" Text="АМПЛИТУДА" />
                                    <TextBlock x:Name="LastAmplitudeText" Classes="readout-value" Text="—" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="readout">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="readout-label" Text="ФАЗА, °" />
                                    <TextBlock x:Name="LastPhaseText" Classes="readout-value" Text="—" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Classes="hint"
                                   Text="Значения обновляются примерно каждые 100 мс по последнему обработанному блоку." />
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="module-label" Text="КРАТКАЯ СПРАВКА" />
                        <TextBlock Classes="hint"
                                   Text="Огибающая: модуль входного сигнала с последующей фильтрацией нижних частот." />
                        <TextBlock Classes="hint"
                                   Text="Синхронная: умножение сигнала на опорную несущую заданной частоты, фильтрация нижних частот и оценка амплитуды и фазы." />
                        <TextBlock Classes="hint"
                                   Text="Нет: демодуляция отключена, выходной поток повторяет входной сигнал." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
