<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="760"
        x:Class="VibroAnalyzer.App.MixerWindow"
        Title="Микшер: выбор каналов"
        Width="840" Height="760"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Border Classes="chassis" Margin="12">
        <DockPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
                <TextBlock Classes="tag" Text="МИКШЕР · ВЫБОР ИСТОЧНИКОВ" />
                <TextBlock Classes="hero" Text="Новый виртуальный вход" FontSize="22" />
                <TextBlock Classes="subtitle"
                           Text="Отметьте конкретные каналы, задайте усиление и полосу каждого источника. Результат — отдельная шина для анализаторов." />
            </StackPanel>

            <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,10">
                <WrapPanel>
                    <TextBlock Classes="label" Text="РЕЖИМ" Margin="0,0,7,0" />
                    <ComboBox x:Name="ModeCombo" Width="220" />
                </WrapPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Classes="card" Padding="12" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CancelButton" Content="Отмена" MinWidth="100" />
                        <Button x:Name="CreateButton" Content="Создать" Classes="primary" MinWidth="110" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Classes="hint" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Classes="card">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="module-label"
                               Text="ИСТОЧНИКИ" Margin="0,0,0,8" />
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SourcesPanel" Spacing="0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
