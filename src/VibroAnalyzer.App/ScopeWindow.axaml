<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1040" d:DesignHeight="700"
        x:Class="VibroAnalyzer.App.ScopeWindow"
        Title="Осциллограф"
        Width="1040" Height="700" MinWidth="780" MinHeight="500">

    <Border Classes="chassis" Margin="12">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="tag" Text="ИЗМЕРИТЕЛЬНОЕ ОКНО · ОСЦИЛЛОГРАФ" />
                    <TextBlock Classes="hero" Text="Осциллограф" FontSize="22" />
                    <TextBlock Classes="subtitle"
                               Text="Временная форма сигнала с выбранного канала и базовые измерения." />
                    <TextBlock x:Name="BoundText" Classes="hint" Text="Шина не задана" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="HelpButton" Content="?"
                        Classes="help" VerticalAlignment="Top" Margin="10,0,0,0" />
            </Grid>

            <Border Grid.Row="1" Classes="card" Padding="12">
                <StackPanel Spacing="10">
                    <WrapPanel>
                        <TextBlock Classes="label" Text="ОКНО, С" Margin="0,0,6,0" />
                        <NumericUpDown x:Name="TimeWindowBox" Width="116" Margin="0,0,16,0"
                                       Minimum="0.005" Maximum="0.5" Increment="0.005"
                                       FormatString="0.000" ClipValueToMinMax="True" Value="0.05" />

                        <TextBlock Classes="label" Text="КАНАЛ" Margin="0,0,6,0" />
                        <NumericUpDown x:Name="ChannelBox" Width="90" Margin="0,0,16,0"
                                       Minimum="0" Maximum="7" Increment="1"
                                       FormatString="0" ClipValueToMinMax="True" Value="0" />

                        <TextBlock Classes="label" Text="ИСТОЧНИК" Margin="0,0,6,0" />
                        <ComboBox x:Name="SourceBox" Width="200" SelectedIndex="0">
                            <ComboBoxItem Content="Сырой сигнал" />
                            <ComboBoxItem Content="Демодулированный" />
                        </ComboBox>
                    </WrapPanel>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="readout">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="readout-label" Text="VPP" />
                                <TextBlock x:Name="VppLabel" Classes="readout-value" Text="—" />
                                <TextBlock x:Name="VppUnit" Classes="readout-unit" Text="В" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="readout">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="readout-label" Text="СКЗ" />
                                <TextBlock x:Name="RmsLabel" Classes="readout-value" Text="—" />
                                <TextBlock x:Name="RmsUnit" Classes="readout-unit" Text="В" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="readout">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="readout-label" Text="ЧАСТОТА" />
                                <TextBlock x:Name="FrequencyLabel" Classes="readout-value" Text="—" />
                                <TextBlock Classes="readout-unit" Text="Гц" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Classes="readout">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="readout-label" Text="DC" />
                                <TextBlock x:Name="DcLabel" Classes="readout-value" Text="—" />
                                <TextBlock x:Name="DcUnit" Classes="readout-unit" Text="В" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="screen" Padding="4">
                <sp:AvaPlot x:Name="PlotView" />
            </Border>
        </Grid>
    </Border>
</Window>
