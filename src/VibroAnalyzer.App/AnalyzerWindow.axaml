<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="1000" d:DesignHeight="720"
        x:Class="VibroAnalyzer.App.AnalyzerWindow"
        Title="Анализатор"
        Width="1000" Height="720"
        MinWidth="760" MinHeight="520">

    <Border Classes="chassis" Margin="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="TagText" Classes="tag" Text="АНАЛИЗАТОР" />
                    <TextBlock x:Name="TitleText" Classes="hero" Text="Анализатор" FontSize="22" />
                    <TextBlock x:Name="DescriptionText" Classes="subtitle" />
                    <TextBlock x:Name="BoundText" Classes="hint" Text="Шина не задана" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="HelpButton" Content="?"
                        Classes="help" VerticalAlignment="Top" Margin="10,0,0,0" />
            </Grid>

            <Border x:Name="ParametersCard" Grid.Row="1" Classes="card" Padding="12" IsVisible="False">
                <StackPanel Spacing="8">
                    <TextBlock Classes="module-label" Text="ПАРАМЕТРЫ" />
                    <WrapPanel x:Name="ParametersPanel" ItemSpacing="12" LineSpacing="8" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="card" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="module-label" Text="ПОКАЗАНИЯ" />
                    <WrapPanel x:Name="ReadoutsPanel" ItemSpacing="8" LineSpacing="8" />
                    <TextBlock x:Name="StatusText" Classes="hint" Text="Ожидание данных..." />
                </StackPanel>
            </Border>

            <Border x:Name="PlotBorder" Grid.Row="3" Classes="screen" Padding="4">
                <sp:AvaPlot x:Name="PlotView" />
            </Border>
        </Grid>
    </Border>
</Window>
