<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="760"
        x:Class="VibroAnalyzer.App.SettingsWindow"
        Title="Настройки"
        Width="900" Height="760"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Border Classes="chassis" Margin="12">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
                <TextBlock Classes="tag" Text="НАСТРОЙКИ · ДЕМО-РЕЖИМ" />
                <TextBlock Classes="hero" Text="Настройки" FontSize="22" />
                <TextBlock Classes="subtitle"
                           Text="Демо-режим синтезирует входной сигнал из набора тонов. В нём не используются реальные микрофоны и динамики." />
            </StackPanel>

            <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="DemoModeCheck" Content="Демо-режим: синтезировать вход" />
                    <WrapPanel>
                        <TextBlock Classes="label" Text="ШУМ" Margin="0,0,7,0" />
                        <NumericUpDown x:Name="NoiseBox" Width="120" Minimum="0" Maximum="0.2"
                                       Increment="0.001" FormatString="0.000"
                                       ClipValueToMinMax="True" Value="0.004" />
                        <TextBlock Classes="hint" Text="  амплитуда шума, добавляемого к тонам"
                                   VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Classes="card" Padding="12" Margin="0,10,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CancelButton" Content="Отмена" MinWidth="100" />
                        <Button x:Name="ApplyButton" Content="Применить" Classes="primary" MinWidth="110" />
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Classes="hint" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Classes="card">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="AddToneButton" DockPanel.Dock="Right"
                                Content="Добавить тон" Classes="small" />
                        <TextBlock Classes="module-label" Text="КОНСТРУКТОР ЧАСТОТ И КОЛЕБАНИЙ"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,8"
                               Text="Канал −1 означает все каналы. Форма: синус, прямоугольник или треугольник. Сигнал — сумма тонов плюс шум." />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="120,100,150,90,*"
                          Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Classes="label" Text="ЧАСТОТА, ГЦ" />
                        <TextBlock Grid.Column="1" Classes="label" Text="АМПЛИТУДА" />
                        <TextBlock Grid.Column="2" Classes="label" Text="ФОРМА" />
                        <TextBlock Grid.Column="3" Classes="label" Text="КАНАЛ" />
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TonesPanel" Spacing="0" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
